# =============================================================================
# AI SOC Analytics Platform — Environment Configuration Template
# Copy this file to `.env` (and/or `backend/.env` for local standalone runs).
# =============================================================================

# --- PostgreSQL Database (Docker & Local) -------------------------------------
# Standardized database credentials used by docker-compose.yml and local instances:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=aisoc
POSTGRES_PORT=5432

# Primary application database URL:
# For Docker Compose: automatically assembled from POSTGRES_* variables
# For non-Docker local runs against Postgres:
DATABASE_URL=postgresql+psycopg2://postgres:postgres123@localhost:5432/aisoc
# For non-Docker local runs against SQLite:
# DATABASE_URL=sqlite:///./soc.db

# Dedicated Auth database (SQLite)
AUTH_DATABASE_URL=sqlite:///backend/database/login.db
SKIP_DB_MIGRATION=false

# --- Core Application & JWT Security -----------------------------------------
SECRET_KEY=production-secret-key-change-in-prod-9988776655
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173

# --- Neo4j Graph Database -----------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- Redis Cache --------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Google OAuth 2.0 ---------------------------------------------------------
GOOGLE_CLIENT_ID=495214479999-6aq75kg8j5fo1feh0kso11v01lgfdic0.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=495214479999-6aq75kg8j5fo1feh0kso11v01lgfdic0.apps.googleusercontent.com

# --- Frontend Build Configurations --------------------------------------------
VITE_API_URL=http://localhost:8000

# --- Threat Intelligence API Keys (Optional Live Enrichment) ------------------
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
ALIENVAULT_OTX_KEY=
SHODAN_API_KEY=

# --- LLM Investigation Copilot (Local / Remote) -------------------------------
OLLAMA_URL=http://localhost:11434/api/generate
GEMINI_API_KEY=
OPENAI_API_KEY=
